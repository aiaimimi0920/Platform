# 本地测试默认使用：
# http://127.0.0.1:3100
# 对应回调地址：
# http://127.0.0.1:3100/api/auth/callback/linuxdo
#
# 如果切换到线上，请改成：
# NEXT_PUBLIC_APP_URL=https://ai.aiaimimi.com
# 并确保 Linux Do Connect 后台登记的回调地址是：
# https://ai.aiaimimi.com/api/auth/callback/linuxdo
#
# 敏感值已归档在 AIRead/密钥/NeuroLoom密钥.json
NEXTAUTH_SECRET=copy-from-AIRead-NeuroLoom密钥
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3100
OAUTH_CLIENT_ID=kFU17zbkD2d2RCB3pEYoFvn4bdmY3x21
OAUTH_CLIENT_SECRET=copy-from-AIRead-NeuroLoom密钥
CORE_INTERNAL_URL=http://127.0.0.1:4000
ARBITRATION_ATTACHMENT_FETCH_TIMEOUT_MS=30000
INTERNAL_API_TOKEN=replace-with-the-same-token-as-core
REDIS_URL=redis://127.0.0.1:6379
PLATFORM_OPERATOR_USER_IDS=
