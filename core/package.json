    "dev": "tsx watch src/index.ts",
    "db:migrate": "node dist/scripts/migrate.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.901.0",
    "@aws-sdk/s3-request-presigner": "^3.901.0",
    "@fastify/cors": "^11.1.0",
    "@neuro/account-domain": "*",
    "@neuro/contracts": "*",
    "drizzle-orm": "^0.44.2",
    "fastify": "^5.6.1",
    "ioredis": "^5.8.2",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^20.19.27",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3"
  }
}
