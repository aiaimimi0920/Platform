{
  "name": "@neuro/account-domain",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "prebuild": "npm run build --workspace @neuro/contracts && npm run build --workspace @neuro/backend-foundation",
    "pretypecheck": "npm run build --workspace @neuro/contracts && npm run build --workspace @neuro/backend-foundation",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "node dist/scripts/migrate.js",
    "test": "node --test --import tsx src/modules/email-native/model.test.ts src/modules/email-ingress/model.test.ts src/modules/mailbox/player/idempotency.test.ts src/modules/user-progression/task-scope.test.ts",
    "test:integration": "node --test --import tsx src/modules/mailbox/player/idempotency.integration.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.918.0",
    "@aws-sdk/s3-request-presigner": "^3.918.0",
    "@fastify/cors": "^11.1.0",
    "@neuro/backend-foundation": "*",
    "@neuro/contracts": "*",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "ioredis": "^5.8.2",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^20.19.27",
    "@types/pg": "^8.15.5",
    "typescript": "^5.8.3"
  }
}
