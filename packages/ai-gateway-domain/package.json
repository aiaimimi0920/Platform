{
  "name": "@neuro/ai-gateway-domain",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "prebuild": "npm run build --workspace @neuro/contracts && npm run build --workspace @neuro/backend-foundation",
    "pretypecheck": "npm run build --workspace @neuro/contracts && npm run build --workspace @neuro/backend-foundation",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "node dist/scripts/migrate.js",
    "test": "node --test --import tsx src/modules/gateway/adaptive-concurrency.test.ts src/modules/gateway/analysis-alert.test.ts src/modules/gateway/analysis-anomaly.test.ts src/modules/gateway/analysis-auto-remediation.test.ts src/modules/gateway/analysis-baseline.test.ts src/modules/gateway/analysis-diff.test.ts src/modules/gateway/analysis-escalation.test.ts src/modules/gateway/analysis-export.test.ts src/modules/gateway/analysis-incident.test.ts src/modules/gateway/analysis-inventory.test.ts src/modules/gateway/analysis-policy.test.ts src/modules/gateway/analysis-provider-routing.test.ts src/modules/gateway/analysis-remediation.test.ts src/modules/gateway/analysis-remediation-execution.test.ts src/modules/gateway/analysis-remediation-impact.test.ts src/modules/gateway/analysis-remediation-effectiveness.test.ts src/modules/gateway/analysis-remediation-snapshot-anomaly.test.ts src/modules/gateway/analysis-remediation-snapshot-inventory.test.ts src/modules/gateway/analysis-remediation-snapshot-trend.test.ts src/modules/gateway/analysis-timeline.test.ts src/modules/gateway/analysis-trend.test.ts src/modules/gateway/balance-status.test.ts src/modules/gateway/content-filter.test.ts src/modules/gateway/standard-error.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.918.0",
    "@neuro/backend-foundation": "*",
    "@neuro/contracts": "*",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.8.2",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^20.19.27",
    "@types/pg": "^8.15.5",
    "typescript": "^5.8.3"
  }
}
