{
  "name": "neuroloom-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/contracts",
    "packages/backend-foundation",
    "packages/ai-gateway-domain",
    "packages/account-domain",
    "services/account-api",
    "services/account-worker",
    "core",
    "executor",
    "worker",
    "web"
