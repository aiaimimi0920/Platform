PORT=4000
DATABASE_URL=postgres://user:password@postgres-primary:5432/neuroloom
ACCOUNT_DATABASE_URL=
REDIS_URL=redis://valkey-primary:6379
ACCOUNT_REDIS_URL=
INTERNAL_API_TOKEN=replace-me
# AI_GATEWAY_INTERNAL_URL is the Rust gateway internal base URL used by account-api to call gateway management APIs.
AI_GATEWAY_INTERNAL_URL=http://gateway:4200
# AI_GATEWAY_MANAGEMENT_TOKEN is the caller token sent from account-api to the Rust gateway for management authorization.
AI_GATEWAY_MANAGEMENT_TOKEN=replace-me
ACCOUNT_EMAIL_DELIVERY_MODE=console
ACCOUNT_EMAIL_CONSOLE_EXPOSE_VERIFICATION_CODE=true
EMAIL_NATIVE_INGRESS_DOMAIN=mail.example.com
ACCOUNT_EMAIL_MAILGUN_SIGNING_KEY=replace-me
ACCOUNT_EMAIL_INGRESS_SIGNATURE_MAX_AGE_SECONDS=900
ACCOUNT_EMAIL_VERIFICATION_SECRET=replace-me
ACCOUNT_EMAIL_VERIFICATION_TTL_MINUTES=15
EMAIL_NATIVE_TASK_DEFAULT_REWARD_CURRENCY=mira
EMAIL_NATIVE_TASK_DEFAULT_REWARD_AMOUNT=100
EMAIL_NATIVE_TASK_DEFAULT_BOND_AMOUNT=0
EMAIL_NATIVE_TASK_DEFAULT_PRICING_MODE=flat_task
EMAIL_NATIVE_TASK_DEFAULT_OPERATION_MODE=manual
BENEFIT_SERVICE_API_KEY_SECRET=replace-me
BENEFIT_SERVICE_API_PUBLIC_BASE_URL=https://new-api.example.com/v1
AI_GATEWAY_API_KEY_SECRET=replace-me
AI_GATEWAY_PUBLIC_BASE_URL=https://new-api.example.com
AI_GATEWAY_COMPATIBILITY_BASE_URL=https://account-api.example.com/v1/new-api
AI_GATEWAY_MODELS_CACHE_TTL_SECONDS=60
PLATFORM_OPERATOR_USER_IDS=operator-1,operator-2
PLATFORM_INTERNAL_URL=http://neuroloom-core:4000
OBJECT_STORAGE_DRIVER=s3-compatible
OBJECT_STORAGE_BUCKET=neuroloom-prod
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ENDPOINT=https://replace-me.r2.cloudflarestorage.com
OBJECT_STORAGE_ACCESS_KEY_ID=replace-me
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-me
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_SIGNED_URL_TTL_SECONDS=900
S3_PUBLIC_BASE_URL=https://files.example.com
ARBITRATION_EVIDENCE_REMOTE_UPLOAD_STRATEGY=prepared_remote_put
