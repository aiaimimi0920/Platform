PORT=3000
ACCOUNT_INTERNAL_URL=http://neuroloom-account-api:4000
ACCOUNT_WORKER_INTERNAL_URL=http://neuroloom-account-worker:7303
CORE_INTERNAL_URL=http://neuroloom-core:4000
INTERNAL_API_TOKEN=replace-me
# Web calls the Rust gateway internal API directly for operator gateway management.
AI_GATEWAY_INTERNAL_URL=http://gateway:4200
# This is the caller token that web sends to the Rust gateway management endpoints.
AI_GATEWAY_MANAGEMENT_TOKEN=replace-me
OAUTH_CLIENT_ID=replace-me
OAUTH_CLIENT_SECRET=replace-me
NEXTAUTH_SECRET=replace-me
NEXTAUTH_URL=https://app.example.com
NEXT_PUBLIC_APP_URL=https://app.example.com
DEV_AUTH_BYPASS_ENABLED=false
DEV_AUTH_BYPASS_PROVIDER_USER_ID=local-dev-account
DEV_AUTH_BYPASS_USERNAME=local-dev
DEV_AUTH_BYPASS_NAME=Local Dev
DEV_AUTH_BYPASS_EMAIL=local-dev@example.test
DEV_AUTH_BYPASS_TRUST_LEVEL=4
