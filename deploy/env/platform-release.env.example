# Copy outside the release directory, replace every replace-me value, and set
# PLATFORM_RUNTIME_ENV_FILE to the resulting file before running Compose.
DATABASE_URL=postgres://replace-me:replace-me@postgres.example.com:5432/neuroloom
ACCOUNT_DATABASE_URL=postgres://replace-me:replace-me@postgres.example.com:5432/neuroloom
REDIS_URL=rediss://valkey.example.com:6379
ACCOUNT_REDIS_URL=rediss://valkey.example.com:6379
CORE_PUBLIC_BASE_URL=https://api.example.com
CORE_INTERNAL_URL=http://core:4000
PLATFORM_INTERNAL_URL=http://core:4000
ACCOUNT_INTERNAL_URL=http://account-api:4000
ACCOUNT_WORKER_INTERNAL_URL=http://account-worker:7303
AI_GATEWAY_INTERNAL_URL=https://gateway-internal.example.com
AI_GATEWAY_PUBLIC_BASE_URL=https://gateway.example.com
AI_GATEWAY_COMPATIBILITY_BASE_URL=https://gateway.example.com/v1/new-api
BENEFIT_SERVICE_API_PUBLIC_BASE_URL=https://gateway.example.com/v1
TEA_SERVER_URL=https://tea-internal.example.com
INTERNAL_API_TOKEN=replace-me
AI_GATEWAY_MANAGEMENT_TOKEN=replace-me
AI_GATEWAY_API_KEY_SECRET=replace-me
BENEFIT_SERVICE_API_KEY_SECRET=replace-me
TEA_AUTH_TOKEN=replace-me
OAUTH_CLIENT_ID=replace-me
OAUTH_CLIENT_SECRET=replace-me
NEXTAUTH_SECRET=replace-me
NEXTAUTH_URL=https://app.example.com
NEXT_PUBLIC_APP_URL=https://app.example.com
PLATFORM_ALLOWED_ORIGINS=https://app.example.com
PLATFORM_OPERATOR_USER_IDS=replace-me
OBJECT_STORAGE_DRIVER=s3-compatible
OBJECT_STORAGE_BUCKET=replace-me
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ENDPOINT=https://replace-me.r2.cloudflarestorage.com
OBJECT_STORAGE_ACCESS_KEY_ID=replace-me
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-me
OBJECT_STORAGE_FORCE_PATH_STYLE=false
S3_PUBLIC_BASE_URL=https://files.example.com
ARBITRATION_EVIDENCE_REMOTE_UPLOAD_STRATEGY=prepared_remote_put
